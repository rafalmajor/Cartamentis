<Window x:Class="Cartamentis.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cartamentis.Wpf.Views"
        xmlns:viewModels="clr-namespace:Cartamentis.Application.ViewModels;assembly=Cartamentis.Application"
        Title="Cartamentis - Mind Map Visualization" 
        Height="600" 
        Width="800" 
        WindowStartupLocation="CenterScreen">
    
    <!-- Input Bindings for keyboard shortcuts -->
    <Window.InputBindings>
        <!-- Add Child (Ctrl+Enter or Insert) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.AddChildCommand}" 
                    Key="Enter" 
                    Modifiers="Control" />
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.AddChildCommand}" 
                    Key="Insert" />
                    
        <!-- Add Sibling (Ctrl+Shift+Enter) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.AddSiblingCommand}" 
                    Key="Enter" 
                    Modifiers="Control,Shift" />
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.AddSiblingCommand}" 
                    Key="Insert" 
                    Modifiers="Shift" />
        
        <!-- Remove Leaf (Delete) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.RemoveLeafCommand}" 
                    Key="Delete" />
                    
        <!-- Remove Subtree (Ctrl+Delete) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.RemoveSubtreeCommand}" 
                    Key="Delete" 
                    Modifiers="Control" />
        
        <!-- Promote (Shift+Tab) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.PromoteCommand}" 
                    Key="Tab" 
                    Modifiers="Shift" />
        
        <!-- Demote (Tab) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.DemoteCommand}" 
                    Key="Tab" />
        
        <!-- Clone (Ctrl+D) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.CloneSubtreeCommand}" 
                    Key="D" 
                    Modifiers="Control" />
        
        <!-- Rename (F2) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.EditTopicCommand}" 
                    CommandParameter="{Binding ElementName=MindMapControl, Path=DataContext.SelectedTopic}" 
                    Key="F2" />
        
        <!-- Select Root (Home) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.SelectRootCommand}" 
                    Key="Home" />
        
        <!-- New Mind Map (Ctrl+N) -->
        <KeyBinding Command="{Binding ElementName=MindMapControl, Path=DataContext.NewMindMapCommand}" 
                    Key="N" 
                    Modifiers="Control" />
    </Window.InputBindings>
    
    <Grid>
        <local:MindMapView x:Name="MindMapControl" />
    </Grid>
</Window>
