<UserControl x:Class="Cartamentis.Wpf.Views.MindMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cartamentis.Wpf.Views"
             xmlns:viewModels="clr-namespace:Cartamentis.Application.ViewModels;assembly=Cartamentis.Application"
             xmlns:converters="clr-namespace:Cartamentis.Wpf.Converters">
    <UserControl.Resources>
        <converters:AddOffsetConverter x:Key="AddOffsetConverter" />
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Auto" 
                  CanContentScroll="True">
        <Canvas x:Name="MindMapCanvas" 
                Background="White" 
                ClipToBounds="True">
            
            <!-- Topics -->
            <ItemsControl ItemsSource="{Binding AllTopics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:TopicViewModel}">
                        <Border Width="120" 
                                Height="40" 
                                Background="White" 
                                BorderBrush="Black" 
                                BorderThickness="1" 
                                Panel.ZIndex="1">
                            <TextBlock Text="{Binding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Connections (drawn behind topics) -->
            <!-- Using MultiBinding for connections would be better, but for simplicity we use direct binding -->
            <!-- The connection goes from the center of parent to the center of child -->
            <ItemsControl ItemsSource="{Binding Connections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Connection from center of parent (X+60, Y+20) to center of child (X+60, Y+20) -->
                        <!-- Box size is 120x40, so center is at +60, +20 from top-left corner -->
                        <Line X1="{Binding From.X, Converter={StaticResource AddOffsetConverter}, ConverterParameter=60}" 
                              Y1="{Binding From.Y, Converter={StaticResource AddOffsetConverter}, ConverterParameter=20}"
                              X2="{Binding To.X, Converter={StaticResource AddOffsetConverter}, ConverterParameter=60}" 
                              Y2="{Binding To.Y, Converter={StaticResource AddOffsetConverter}, ConverterParameter=20}"
                              Stroke="Gray" 
                              StrokeThickness="1" 
                              Panel.ZIndex="0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </ScrollViewer>
</UserControl>
