<UserControl x:Class="Cartamentis.Wpf.Views.MindMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cartamentis.Wpf.Views"
             xmlns:viewModels="clr-namespace:Cartamentis.Application.ViewModels;assembly=Cartamentis.Application"
             xmlns:converters="clr-namespace:Cartamentis.Wpf.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
    <UserControl.Resources>
        <converters:AddOffsetConverter x:Key="AddOffsetConverter" />
        
        <!-- Brush resources -->
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="#FF0066CC" />
        <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#FFE6F2FF" />
        <SolidColorBrush x:Key="NormalBorderBrush" Color="Black" />
        <SolidColorBrush x:Key="NormalBackgroundBrush" Color="White" />
        <SolidColorBrush x:Key="DragAdornerBrush" Color="#400066CC" />
        
        <!-- Style for Topic View -->
        <Style x:Key="TopicBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{StaticResource NormalBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Panel.ZIndex" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}" />
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="BorderBrush" Value="{StaticResource DragAdornerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Context Menu for topics -->
        <ContextMenu x:Key="TopicContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Add Child" Command="{Binding DataContext.AddChildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Add Sibling" Command="{Binding DataContext.AddSiblingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Rename" Command="{Binding DataContext.EditTopicCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Promote" Command="{Binding DataContext.PromoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Demote" Command="{Binding DataContext.DemoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Clone" Command="{Binding DataContext.CloneSubtreeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Remove Leaf" Command="{Binding DataContext.RemoveLeafCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Remove Subtree" Command="{Binding DataContext.RemoveSubtreeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Extract Subtree" Command="{Binding DataContext.ExtractSubtreeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>
    </UserControl.Resources>
    
    <ScrollViewer x:Name="ScrollViewer" 
                  HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Auto" 
                  CanContentScroll="True"
                  Focusable="True">
        <Canvas x:Name="MindMapCanvas" 
                Background="White" 
                ClipToBounds="True"
                AllowDrop="True"
                PreviewMouseLeftButtonDown="Canvas_PreviewMouseLeftButtonDown"
                PreviewMouseMove="Canvas_PreviewMouseMove"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                Drop="Canvas_Drop"
                DragOver="Canvas_DragOver"
                DragLeave="Canvas_DragLeave"
                MouseRightButtonDown="Canvas_MouseRightButtonDown">
            
            <!-- Connections (drawn behind topics) -->
            <ItemsControl ItemsSource="{Binding Connections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Connection from center of parent (X+60, Y+20) to center of child (X+60, Y+20) -->
                        <!-- Box size is 120x40, so center is at +60, +20 from top-left corner -->
                        <Line X1="{Binding From.X, Converter={StaticResource AddOffsetConverter}, ConverterParameter=60}" 
                              Y1="{Binding From.Y, Converter={StaticResource AddOffsetConverter}, ConverterParameter=20}"
                              X2="{Binding To.X, Converter={StaticResource AddOffsetConverter}, ConverterParameter=60}" 
                              Y2="{Binding To.Y, Converter={StaticResource AddOffsetConverter}, ConverterParameter=20}"
                              Stroke="Gray" 
                              StrokeThickness="1" 
                              Panel.ZIndex="0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Topics -->
            <ItemsControl ItemsSource="{Binding AllTopics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:TopicViewModel}">
                        <Border Style="{StaticResource TopicBorderStyle}"
                                ContextMenu="{StaticResource TopicContextMenu}"
                                MouseLeftButtonDown="Topic_MouseLeftButtonDown"
                                MouseRightButtonDown="Topic_MouseRightButtonDown"
                                PreviewMouseMove="Topic_PreviewMouseMove"
                                MouseMove="Topic_MouseMove"
                                AllowDrop="False">
                            <TextBlock Text="{Binding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" 
                                       FontWeight="{Binding IsRoot, Converter={StaticResource BooleanToFontWeightConverter}}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Drag adorner (visual feedback during drag) -->
            <Border x:Name="DragAdorner" 
                    Width="120" 
                    Height="40" 
                    Background="{StaticResource DragAdornerBrush}" 
                    BorderBrush="{StaticResource SelectedBorderBrush}" 
                    BorderThickness="2" 
                    CornerRadius="4" 
                    Panel.ZIndex="100" 
                    Visibility="Collapsed">
                <TextBlock x:Name="DragAdornerText" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Foreground="White" 
                           FontSize="12" />
            </Border>
        </Canvas>
    </ScrollViewer>
</UserControl>
