<Application x:Class="Cartamentis.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cartamentis.Wpf"
             xmlns:converters="clr-namespace:Cartamentis.Wpf.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Register converters globally -->
        <converters:AddOffsetConverter x:Key="AddOffsetConverter" />
        <converters:BooleanToFontWeightConverter x:Key="BooleanToFontWeightConverter" />
    </Application.Resources>
</Application>
